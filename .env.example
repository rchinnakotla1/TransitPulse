# Copy this file to .env and fill in your own keys:  copy .env.example .env
# .env is git-ignored, so your real keys never get pushed.

# OpenAI key for the LLM narratives (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MBTA V3 API key for Live Mode (free: https://api-v3.mbta.com). Optional; without it you get 20 requests/min.
MBTA_API_KEY=
